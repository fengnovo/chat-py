[Unit]
Description=Chat synthetic canary probe (chat run + knowledge retrieval, every 15m)
Documentation=file:///opt/chat/docs/observability/runbooks/api-latency.md
After=network-online.target chat-api.service chat-worker.service chat-knowledge.service
Wants=network-online.target

[Service]
Type=oneshot
User=chatapp
Group=chatapp
WorkingDirectory=/opt/chat
EnvironmentFile=-/opt/chat/.env
# 需要专用合成用户凭据：PROBE_API_TOKEN，可选 PROBE_KB_ID
ExecStart=/opt/chat/deploy/observability/synthetic/run-synthetic.sh --canary
TimeoutStartSec=120
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StandardOutput=journal
StandardError=journal
