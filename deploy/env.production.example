# 生产环境配置模板 —— 复制到 /opt/chat/.env 后逐项填写。
#
#   cp deploy/env.production.example /opt/chat/.env
#   chmod 600 /opt/chat/.env
#
# 需要生成的三处密钥：
#   AUTH_JWT_SECRET        openssl rand -hex 32
#   POSTGRES_PASSWORD      openssl rand -hex 16
#   MINIO_ROOT_PASSWORD    openssl rand -hex 16
#
# 注意：POSTGRES_PASSWORD 与 DATABASE_URL 里的密码必须是同一个值。

# ============================================================
# 运行环境
# ============================================================
NODE_ENV=production

# ============================================================
# 对外服务
# ============================================================
# Web 监听端口（Nginx 反代到这里）
PORT=3020
# API 只监听本机，公网不可达
API_HOST=127.0.0.1
API_PORT=8002
# 浏览器访问的正式地址（CORS 与 cookie 依赖它）
WEB_ORIGIN=https://chat.example.com
# Next 在构建期会把 /api 的 rewrite 目标写进 .next/routes-manifest.json；
# 生产用 Nginx 直接把 /api 转发到 8002，这里保持一致即可。
AGENT_API_ORIGIN=http://127.0.0.1:8002

# ============================================================
# 基础设施（对应 deploy/compose.infra.yaml，只监听 127.0.0.1）
# ============================================================
DATABASE_URL=postgresql://agent:REPLACE_POSTGRES_PASSWORD@127.0.0.1:55432/agent
REDIS_URL=redis://127.0.0.1:56379
S3_ENDPOINT=http://127.0.0.1:59000
# 预签名 URL 会发给浏览器，必须是浏览器可达的 HTTPS 地址。
# 推荐与主站同源：Nginx 在 443 上把 /agent-artifacts/ 反代到 MinIO，
# 无需在云安全组额外放行端口，也不存在跨域 CORS 问题。
S3_PUBLIC_ENDPOINT=https://chat.example.com
# 备选：独立端口方案（需安全组放行 9443，并启用 Nginx 的 9443 server 段）：
#S3_PUBLIC_ENDPOINT=https://chat.example.com:9443
S3_REGION=us-east-1
S3_BUCKET=agent-artifacts
S3_ACCESS_KEY=REPLACE_MINIO_ROOT_USER
S3_SECRET_KEY=REPLACE_MINIO_ROOT_PASSWORD
ARTIFACT_MAX_BYTES=100000000
PROJECT_UPLOAD_MAX_BYTES=20000000

# 仅供 compose 使用（应用进程忽略这两个变量）
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
MINIO_ROOT_USER=chatagent
MINIO_ROOT_PASSWORD=REPLACE_MINIO_ROOT_PASSWORD

# ============================================================
# 鉴权：本地账号密码登录
# ============================================================
AUTH_MODE=password
# 至少 32 字符；改动会使已登录会话立即失效
AUTH_JWT_SECRET=REPLACE_OPENSSL_RAND_HEX_32
# 生产默认关闭自助注册；2 人验证建议由 admin 建号（见 deploy/README.md）
AUTH_SIGNUP_ENABLED=false
SIGNUP_TENANT_ID=00000000-0000-4000-8000-000000000001
DEV_TENANT_ID=00000000-0000-4000-8000-000000000001
DEV_USER_ID=00000000-0000-4000-8000-000000000001

# ============================================================
# OAuth 社交登录（GitHub / Google）—— 与密码登录并行，留空则不启用
# ============================================================
# GitHub OAuth App: https://github.com/settings/developers
#   Authorization callback URL 填 https://chat.example.com/api/auth/oauth/github/callback
#OAUTH_GITHUB_CLIENT_ID=
#OAUTH_GITHUB_CLIENT_SECRET=
# Google OAuth: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI 填 https://chat.example.com/api/auth/oauth/google/callback
#OAUTH_GOOGLE_CLIENT_ID=
#OAUTH_GOOGLE_CLIENT_SECRET=
# 回调地址，默认 ${WEB_ORIGIN}/api/auth/oauth/{provider}/callback，一般无需手动指定
#OAUTH_CALLBACK_URL=
# State 签名密钥，默认复用 AUTH_JWT_SECRET（至少 32 字符）
#OAUTH_STATE_SECRET=
# Google API 国内被墙，服务器需配代理；GitHub 和密码登录不需要
#HTTPS_PROXY=http://127.0.0.1:7890

# ============================================================
# 模型（主 Agent；与 embedding 完全独立）
# ============================================================
AGENT_DRIVER=deep
# 国内可选：百炼兼容模式（qwen）或 DeepSeek
MODEL=openai:qwen3-max
OPENAI_API_KEY=REPLACE_MODEL_API_KEY
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL=openai:deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_MAX_TOKENS=16000
# 验证阶段建议调小以控费（默认 600 / 120 是给长任务留的）
AGENT_RECURSION_LIMIT=200
AGENT_MODEL_CALL_LIMIT=40
# FALLBACK_MODELS=openai:qwen-plus
# ANTHROPIC_API_KEY=

# ============================================================
# 沙箱：宿主机 Docker
# ============================================================
SANDBOX_RUNTIME=docker
DOCKER_SANDBOX_IMAGE=chat-agent-sandbox:latest
DOCKER_SANDBOX_COMMAND_TIMEOUT_MS=180000
DOCKER_SANDBOX_SESSIONS_ROOT=/opt/chat/data/sandboxes
DOCKER_SANDBOX_WORKSPACE_PATH=/mnt/user-data/workspace

# ============================================================
# Worker
# ============================================================
WORKER_CONCURRENCY=2
WORKSPACE_ROOT=/opt/chat/data/workspaces

# DeepAgents memory/skills（宿主机路径，Worker 启动时上传到沙箱）
#AGENT_MEMORY_FILE=/opt/chat/.deepagents/AGENTS.md
#AGENT_SKILLS_DIR=/opt/chat/.deepagents/skills

# 历史消息压缩：token 数超过阈值时自动压缩旧消息，降低 LLM 延迟
AGENT_SUMMARIZATION_TRIGGER_TOKENS=30000
AGENT_SUMMARIZATION_KEEP_TOKENS=15000

# ============================================================
# 知识库：本次不部署 knowledge-service，全部关闭
# ============================================================
# API 启动时强制要求这三个非敏感元数据齐全（纯聊天部署也必须给）。
# 填最终打算使用的 embedding profile，以后启用知识库时 collection 才不会错位。
EMBEDDING_PROFILE=bailian-qwen-text-embedding-1024
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
QDRANT_COLLECTION_PREFIX=knowledge
# 没有消费者，保持 false，避免每轮白等 MCP 超时
KNOWLEDGE_MCP_ENABLED=false
KNOWLEDGE_DOCUMENT_MAX_BYTES=20000000
KNOWLEDGE_INDEX_QUEUE=knowledge-index

# 通用 MCP 工具必须显式配置；未设置时 Worker 不加载任何示例公网 MCP。
MCP_CONFIG_PATH=/opt/chat/config/mcp.json

# ============================================================
# 其它
# ============================================================
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_MS=60000
KNOWLEDGE_UPLOAD_RATE_LIMIT_REQUESTS=3000
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
OUTBOX_RECONCILE_INTERVAL_MS=5000
OUTBOX_STALE_AFTER_MS=30000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=keen-agent

# ============================================================
# 可观测性（凭据必须由 secret manager 注入，不得写入此模板）
# ============================================================
OTEL_ENABLED=true
OTEL_SERVICE_NAME=chat-agent
OTEL_ENVIRONMENT=production
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.05
OTEL_METRIC_EXPORT_INTERVAL=60000
OBSERVABILITY_CAPTURE_CONTENT=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_ENABLED=false
LANGFUSE_SAMPLE_RATE=0.05
OBSERVABILITY_LOG_LEVEL=info
OBSERVABILITY_SHUTDOWN_TIMEOUT_MS=5000

# ─── VLM 图片 caption（异步队列 knowledge-caption）──────────────────────────────
# 生产默认关闭：常态不消耗 VLM 额度；只有开通「视觉描述检索」后再启用。
# 启用后需要把对应供应商的 API key 填入；推荐先在 staging 跑通再上 prod。
CAPTION_ENABLED=false
# CAPTION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CAPTION_API_KEY=
# CAPTION_MODEL=qwen-vl-plus
# 混合思考模型（qwen3.8-omni-flash 等）需置 true 关闭思考，否则思考 token 会把 caption 正文挤空。
# CAPTION_DISABLE_THINKING=false
# CAPTION_TIMEOUT_MS=60000
# CAPTION_MAX_CHARS=240
# CAPTION_CONCURRENCY=2
# CAPTION_LEASE_MS=180000
# CAPTION_MAX_ATTEMPTS=3
