# 沙箱镜像的国内加速变体（可选）。
#
# 与 infra/sandbox/Dockerfile 步骤完全一致，只是把 apt / pip / npm 换成国内镜像源。
# 构建阶段要下载约 1GB（apt + pip 科学栈 + vite/react），国内直连 pypi.org 很慢，
# 所以提供这个变体。
#
#   docker build -f deploy/sandbox/Dockerfile.mirror -t chat-agent-sandbox:latest infra/sandbox
#
# ⚠️ 维护提醒：仓库里的 infra/sandbox/Dockerfile 一旦改动，这里必须同步修改。
#    用这条命令确认两者除镜像源外没有差异：
#      diff <(grep -v '^#' infra/sandbox/Dockerfile) <(grep -v '^#' deploy/sandbox/Dockerfile.mirror)
#
# 构建上下文是 infra/sandbox（所以 COPY 的相对路径与原始 Dockerfile 相同）。

FROM node:24.14.0-bookworm-slim

# 换成阿里云 Debian 镜像源（bookworm 用的是 deb822 格式的 sources）
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; \
    fi; \
    if [ -f /etc/apt/sources.list ]; then \
      sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list; \
    fi

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      file \
      fonts-dejavu-core \
      git \
      python3 \
      python3-pip \
      python-is-python3 \
      zip \
    && rm -rf /var/lib/apt/lists/*

# pip 走阿里云 PyPI 镜像
RUN python -m pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ \
    && python -m pip config set global.trusted-host mirrors.aliyun.com \
    && python -m pip install --break-system-packages --no-cache-dir \
      matplotlib \
      openpyxl \
      pillow \
      python-docx \
      python-pptx \
      reportlab

# 只预装离线 React/Vite 依赖，不预置用户网站源码。用户项目完全由 Agent
# 写入本轮沙箱工作区，再通过符号链接复用只读 node_modules。
COPY web-runtime/package.json /opt/chat-web-runtime/package.json
RUN npm config set registry https://registry.npmmirror.com \
    && cd /opt/chat-web-runtime \
    && npm install --no-audit --no-fund
COPY prepare-web-project /usr/local/bin/prepare-web-project
RUN chmod 0755 /usr/local/bin/prepare-web-project

WORKDIR /mnt/user-data/workspace

CMD ["/bin/bash"]
