# Public services
PORT=3020
API_PORT=8002
WEB_ORIGIN=http://localhost:3020
AGENT_API_ORIGIN=http://127.0.0.1:8002

# Infrastructure
DATABASE_URL=postgresql://agent:agent@127.0.0.1:55432/agent
DATABASE_TEST_URL=postgresql://agent:agent@127.0.0.1:55433/agent_test
REDIS_URL=redis://127.0.0.1:56379
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_MS=60000
KNOWLEDGE_UPLOAD_RATE_LIMIT_REQUESTS=3000
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
OUTBOX_RECONCILE_INTERVAL_MS=5000
OUTBOX_STALE_AFTER_MS=30000
S3_ENDPOINT=http://127.0.0.1:59000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=agent-artifacts
S3_ACCESS_KEY=agent
S3_SECRET_KEY=agent-local-secret
ARTIFACT_MAX_BYTES=100000000
PROJECT_UPLOAD_MAX_BYTES=20000000

# API knowledge uploads (the API does not need Qdrant or embedding credentials)
KNOWLEDGE_DOCUMENT_MAX_BYTES=20000000
KNOWLEDGE_INDEX_QUEUE=knowledge-index

# Development identity. Production must use AUTH_MODE=oidc.
# AUTH_MODE options:
#   dev      — fixed tenant/user identity without login (local development only)
#   password — local username/password login (seeded users, JWT session cookie)
#   oidc     — external OIDC provider
AUTH_MODE=dev
DEV_TENANT_ID=00000000-0000-4000-8000-000000000001
DEV_USER_ID=00000000-0000-4000-8000-000000000001
# Required when AUTH_MODE=password (min 32 chars). Generate with: openssl rand -hex 32
# AUTH_JWT_SECRET=
# Public self-service signup at /register (password mode). New accounts join
# SIGNUP_TENANT_ID below as role member and need an admin to gain KB access.
# Defaults: enabled outside production, disabled in production.
# AUTH_SIGNUP_ENABLED=true
# SIGNUP_TENANT_ID=00000000-0000-4000-8000-000000000001
# Seed accounts created by `pnpm --filter @db seed`:
#   admin/admin123  (role admin, 超级管理员)
#   owner/owner123  (role owner, 知识库拥有者)
#   user/user123    (role member, 普通用户)
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URL=

# OAuth2 社交登录（GitHub / Google）：与 AUTH_MODE 正交，password 模式下可叠加使用。
# 新用户首次 OAuth 登录时自动创建账号并加入 SIGNUP_TENANT_ID 租户（角色 member）。
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAuth 回调 URL，缺省为 ${WEB_ORIGIN}/api/auth/oauth/${provider}/callback
# OAUTH_CALLBACK_URL=
# OAuth state 签名密钥（缺省复用 AUTH_JWT_SECRET）
# OAUTH_STATE_SECRET=

# Agent
AGENT_DRIVER=deep
MODEL=openai:gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# FALLBACK_MODELS=openai:gpt-4o-mini,anthropic:claude-sonnet-4
# Reasoning models count thinking tokens against this budget; too small yields empty output.
MODEL_MAX_TOKENS=16000
# Per-run agent budget. Multi-step coding tasks need hundreds of super-steps;
# too small marks a nearly-finished task as failed.
AGENT_RECURSION_LIMIT=600
AGENT_MODEL_CALL_LIMIT=120
# Sandbox runtime: docker (local Docker container, default) or e2b-cloud (E2B Cloud).
SANDBOX_RUNTIME=docker
DOCKER_SANDBOX_IMAGE=chat-agent-sandbox:latest
DOCKER_SANDBOX_COMMAND_TIMEOUT_MS=180000
DOCKER_SANDBOX_SESSIONS_ROOT=./data/sandboxes
DOCKER_SANDBOX_WORKSPACE_PATH=/mnt/user-data/workspace
# E2B Cloud credentials, only required when SANDBOX_RUNTIME=e2b-cloud.
# E2B_API_KEY=
# E2B_TEMPLATE=base
# E2B_TIMEOUT_MS=3600000
# E2B_WORKSPACE_PATH=/home/user/workspace
# E2B_API_URL=
# E2B_SANDBOX_URL=

# Optional tracing. Shared by the CLI and Agent runtime.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=keen-agent-cli
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=

# Worker knowledge MCP (optional per run; keep the shared secret private)
KNOWLEDGE_MCP_ENABLED=false
KNOWLEDGE_MCP_URL=http://127.0.0.1:8090/mcp
KNOWLEDGE_MCP_SECRET=local-graphrag-secret-change-me
KNOWLEDGE_MCP_TIMEOUT_MS=10000

# 通用 MCP 工具仅在显式配置时启用；不要把示例公网配置用于生产聊天。
# 相对路径按仓库根解析（如 packages/ai-cli/mcp/mcp.json），也可用绝对路径；文件不存在时 Worker 启动失败。
MCP_CONFIG_PATH=infra/mcp/mcp.json

# ANYSEARCH MCP API key（mcp.json 通过 ${ANYSEARCH_API_KEY} 注入 Authorization 头）；
# https://www.anysearch.com/docs/mcp-install/mcp-streamable-http 每天2000次调用
ANYSEARCH_API_KEY=

# Optional tracing integration.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Observability (safe local defaults; credentials are injected outside the repository)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=chat-agent
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_METRIC_EXPORT_INTERVAL=60000
OBSERVABILITY_CAPTURE_CONTENT=false
LANGFUSE_ENABLED=false
LANGFUSE_SAMPLE_RATE=0
OBSERVABILITY_LOG_LEVEL=info
OBSERVABILITY_SHUTDOWN_TIMEOUT_MS=5000

# knowledge-service: BullMQ consumer, Qdrant, extraction and budget controls
KNOWLEDGE_SERVICE_PORT=8090
KNOWLEDGE_TOKEN_SECRET=local-graphrag-secret-change-me
QDRANT_URL=http://127.0.0.1:56333
# QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=knowledge
# Non-sensitive profile metadata is also read by the API when it creates a KB.
EMBEDDING_PROFILE=bailian-qwen3.7-text-embedding-1024
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024
# Only knowledge-service should receive the provider endpoint and credential in deployment.
EMBEDDING_PROVIDER=bailian
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=

# 可选6个值（要填必须全部填):PG 召回 + Qdrant 语义向量召回，不填则使用 PostgreSQL 精确召回（按 importance、更新时间取最近 12 条）
# MEMORY_QDRANT_URL=http://127.0.0.1:56333 #生产环境 Qdrant 地址/鉴权按部署实际值填，不要用 127.0.0.1。
# MEMORY_QDRANT_API_KEY= # 本地 Qdrant 无鉴权，不设
# MEMORY_EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
# MEMORY_EMBEDDING_API_KEY=<复用现有 EMBEDDING_API_KEY>
# MEMORY_EMBEDDING_MODEL=qwen3.7-text-embedding
# MEMORY_EMBEDDING_DIM=1024

# 实体/关系抽取走 OpenAI 兼容 Chat Completions；缺省时复用 OPENAI_BASE_URL/OPENAI_API_KEY，模型名支持 "openai:xxx" 前缀。
EXTRACTION_MODEL=deepseek-chat
# EXTRACTION_BASE_URL=
# EXTRACTION_API_KEY=
# KNOWLEDGE_INDEX_LEASE_MS=120000
KNOWLEDGE_CONCURRENCY=2
KNOWLEDGE_BUDGET=1

# ─── VLM 图片 caption（异步队列 knowledge-caption）─────────────────────────────────
#
# 把知识库里的图片转成简短视觉描述，写回向量库后，「金黄酥蛋」这类描述性查询也能命中图片。
#
# 启用条件（三件套缺一不启动 worker，没启用时图片仅以 caption_pending 入库）：
#   CAPTION_ENABLED   总开关：true / false
#   CAPTION_BASE_URL  OpenAI 兼容 /chat/completions 端点的 baseUrl（不带尾斜杠）
#   CAPTION_API_KEY   对应供应商的 Bearer token（必填）
# 百炼：baseUrl=https://dashscope.aliyuncs.com/compatible-mode/v1，model=qwen-vl-plus / qwen3-vl-plus / qwen3.8-omni-flash
# OpenAI：baseUrl=https://api.openai.com/v1，model=gpt-4o-mini
# 智谱：baseUrl=https://open.bigmodel.cn/api/paas/v4，model=glm-4v-plus
# CAPTION_ENABLED=true
# CAPTION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CAPTION_API_KEY=sk-xxx
# CAPTION_MODEL=qwen-vl-plus
# 关闭思考模式：置 true 时向请求体注入 enable_thinking:false。
# omni / 混合思考模型（如 qwen3.8-omni-flash）默认开思考，思考 token 计入 max_tokens
# 会把 caption 正文挤空，必须置 true；qwen-vl-plus 等非思考模型保持 false 即可。
# CAPTION_DISABLE_THINKING=false
# 单张图 VLM 调用最大时长；AbortController 触发后视为失败并进入指数退避重试链。
# CAPTION_TIMEOUT_MS=60000
# caption 输出最大字符数；超出则 trim + 切片，避免模型的长 preamble / markdown 污染向量检索。
# CAPTION_MAX_CHARS=240
# BullMQ worker 并发数（同时处理多少张图片）；受 VLM 供应商 RPM/TPM 上限约束，建议 ≤ 4。
# CAPTION_CONCURRENCY=2
# 数据库租约（lease）过期时间；worker 崩溃后 reconciler 会把卡住的 running 重新入队。
# CAPTION_LEASE_MS=180000
# 单图最大重试次数，按 1s→5s→30s→2min→10min 退避；耗尽后状态归 skipped，不再消耗额度。
# CAPTION_MAX_ATTEMPTS=3


# 你的代理地址，比如 clash/v2ray 的本地端口 google登录用（如果不用google不用管这个）
HTTPS_PROXY=http://127.0.0.1:7897